[Unit]
Description=MyCount UPnP router mapping worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP@
ExecStart=@APP@/.venv/bin/python -B -u -m mycount.server.RouterWorker
Restart=on-failure
RestartSec=3
TimeoutStopSec=200
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
