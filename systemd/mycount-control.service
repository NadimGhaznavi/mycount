[Unit]
Description=MyCount Control web server
After=network.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP@
ExecStart=@APP@/.venv/bin/python -B -u -m mycount.server.ControlServer
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
