[Unit]
Description=MyCount Control web server
After=network.target mariadb.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP@
EnvironmentFile=@DATABASE_ENV@
ExecStart=@APP@/.venv/bin/python -B -u -m mycount.server.ControlServer
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=@APP@/pages/marketing
ReadWritePaths=@APP@/data/cities

[Install]
WantedBy=multi-user.target
