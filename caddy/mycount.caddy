http://@DOMAIN@:@HTTP_PORT@ {
    @HTTP_BIND@
    redir https://@DOMAIN@:@HTTPS_PORT@{uri} permanent
}

https://@DOMAIN@:@HTTPS_PORT@ {
    @HTTPS_BIND@
    @collector path @COLLECTION_PATH@ @HEALTH_PATH@ @COUNT_PATH@
    handle @collector {
        reverse_proxy @UPSTREAM@ {
            header_up @VISITOR_HEADER@ {http.request.remote.host}
        }
    }
    handle {
        respond 404
    }
}
