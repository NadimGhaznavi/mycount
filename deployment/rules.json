{
  "exclude": [],
  "extra": {
    "deployment/rules.json": [
      "deployment/DDeployment.py.in"
    ],
    "mycount/server/ControlPages.py": [
      "mycount/server/templates/control.html",
      "mycount/server/templates/reference.html",
      "mycount/server/templates/marketing.html"
    ],
    "scripts/install-caddy.sh": [
      "caddy/mycount.caddy"
    ],
    "scripts/install-services.sh": [
      "requirements.txt",
      "scripts/install-caddy.sh"
    ],
    "scripts/install.sh": [
      "scripts/install-services.sh"
    ],
    "scripts/new-release.sh": [
      "scripts/update-deployment-dependencies.py"
    ],
    "scripts/update-deployment-dependencies.py": [
      "deployment/rules.json"
    ],
    "scripts/upgrade.sh": [
      "scripts/install-services.sh"
    ],
    "systemd/mycount-control.service": [
      "mycount/server/ControlServer.py",
      "mycount/constants/DMyCount.py"
    ],
    "systemd/mycount-server.service": [
      "mycount/server/__main__.py",
      "mycount/constants/DMyCount.py"
    ],
    "systemd/mycount-router.service": [
      "mycount/server/RouterWorker.py",
      "mycount/constants/DMyCount.py"
    ]
  },
  "output": "mycount/constants/DDeployment.py",
  "python_roots": [
    "mycount",
    "deployment_tools"
  ],
  "scan": [
    "mycount/**/*.py",
    "mycount/server/templates/*.html",
    "deployment_tools/**/*.py",
    "scripts/*.sh",
    "scripts/update-deployment-dependencies.py",
    "systemd/*.service",
    "caddy/*",
    "requirements.txt"
  ],
  "targets": {
    "filesystem": [
      "mycount/activity/DeploymentImpact.py",
      "mycount/activity/ReleaseDeployment.py",
      "scripts/new-release.sh",
      "scripts/install.sh",
      "scripts/upgrade.sh",
      "scripts/uninstall.sh",
      "scripts/clear-upnpc-routes.sh",
      "mycount/constants/DDeployment.py",
      "scripts/update-deployment-dependencies.py",
      "deployment_tools/__main__.py",
      "mycount/activity/ReconcileMarketingScreenshots.py"
    ],
    "listener": [
      "systemd/mycount-server.service",
      "requirements.txt",
      "systemd/mycount-router.service"
    ],
    "report-server": [
      "systemd/mycount-control.service",
      "requirements.txt"
    ]
  },
  "template": "deployment/DDeployment.py.in",
  "template_roots": [
    "mycount/server/templates"
  ]
}
